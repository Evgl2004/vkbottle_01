# ===========================================
# VK BOT
# ===========================================
VK_BOT_TOKEN=your_vk_group_token_here
VK_GROUP_ID=0

# ===========================================
# VK MINI APP
# ===========================================
# ID мини-приложения VK (числовой). Получите в панели разработчика VK.
VK_MINI_APP_ID=0
# Секретный ключ мини-приложения (подпись запросов). Храните в секрете!
VK_MINI_APP_SECRET=
# Базовый URL мини-приложения (для формирования ссылки).
# Если мини-приложение размещено на домене VK, оставьте https://vk.com/app (код автоматически добавит ID приложения).
# Если используется кастомный домен, укажите полный URL (например, https://myapp.example.com).
VK_MINI_APP_URL=https://vk.com/app

# ===========================================
# WEB SERVER (для обработки запросов от Mini App)
# ===========================================
# Включить веб-сервер (true/false)
WEB_ENABLED=true
# Хост для прослушивания (0.0.0.0 для всех интерфейсов)
WEB_HOST=0.0.0.0
# Порт веб-сервера
WEB_PORT=8080

# Список администраторов:
# Формат JSON-массив или CSV-строка:
# ADMIN_USER_IDS=[123456789,987654321]
# ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# ===========================================
# POSTGRESQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vkbot
POSTGRES_USER=vkbot
POSTGRES_PASSWORD=change_me

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===========================================
# IIKO
# ===========================================
IIKO_API_KEY=
IIKO_ORG_ID=
IIKO_BASE_URL=https://api-ru.iiko.services/api/1

# ===========================================
# RUNTIME
# ===========================================
ENV=development
LOG_LEVEL=INFO
# Включает супер-подробный технический DEBUG (включая внутренние логи vkbottle).
# Для обычного тестирования оставляйте false.
LOG_SUPER_VERBOSE=false
