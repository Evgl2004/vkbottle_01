# ===========================================
# VK BOT
# ===========================================
VK_BOT_TOKEN=your_vk_group_token_here
VK_GROUP_ID=0

# Список администраторов:
# Формат JSON-массив или CSV-строка:
# ADMIN_USER_IDS=[123456789,987654321]
# ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# ===========================================
# POSTGRESQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vkbot
POSTGRES_USER=vkbot
POSTGRES_PASSWORD=change_me

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===========================================
# IIKO
# ===========================================
IIKO_API_KEY=
IIKO_ORG_ID=
IIKO_BASE_URL=https://api-ru.iiko.services/api/1

# ===========================================
# RUNTIME
# ===========================================
ENV=development
LOG_LEVEL=INFO
# Включает супер-подробный технический DEBUG (включая внутренние логи vkbottle).
# Для обычного тестирования оставляйте false.
LOG_SUPER_VERBOSE=false
